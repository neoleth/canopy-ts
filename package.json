{
  "name": "@canopynetwork/canopy-ts",
  "version": "0.8.0",
  "description": "TypeScript SDK for Canopy blockchain plugin frontends — signing, keystore, RPC, and WebSocket transport",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./ws": {
      "types": "./dist/ws.d.ts",
      "import": "./dist/ws.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./keystore": {
      "types": "./dist/keystore.d.ts",
      "import": "./dist/keystore.js"
    },
    "./wallet-manager": {
      "types": "./dist/wallet-manager.d.ts",
      "import": "./dist/wallet-manager.js"
    },
    "./node-pool": {
      "types": "./dist/node-pool.d.ts",
      "import": "./dist/node-pool.js"
    },
    "./transaction": {
      "types": "./dist/transaction.d.ts",
      "import": "./dist/transaction.js"
    },
    "./proto/*": "./dist/proto/*"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishedWsProtos": [
    "ws_frame.proto",
    "dice_ws.proto",
    "plinko_ws.proto",
    "market_ws.proto",
    "account.proto"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canopy-network/canopy-ts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && npm run postbuild",
    "postbuild": "node scripts/copy-ws-protos.cjs",
    "dev": "tsc --watch",
    "prepare": "tsc && npm run postbuild",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "protobufjs": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
