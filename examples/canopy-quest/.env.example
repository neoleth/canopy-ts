# Canopy Quest — public configuration.
#
# Everything prefixed with VITE_ is bundled into the client and visible to
# anyone using the app. Only ever put public values here — never an API key,
# an admin RPC credential, or a private key.

# Canopy public RPC endpoint(s). Comma-separate to enable NodePool failover:
# the first entry is the primary, the rest are fallbacks tried in order.
VITE_CANOPY_RPC_URL=http://localhost:50002

# Human-readable network label shown in the UI.
VITE_CANOPY_NETWORK=canopy-devnet

# Network and chain IDs included in every signed transaction. These must match
# the chain you are talking to or the node will reject your transactions.
VITE_CANOPY_NETWORK_ID=1
VITE_CANOPY_CHAIN_ID=1

# Display denomination: how many decimals between 1 CNPY and one base unit.
VITE_CANOPY_DENOM_EXPONENT=6
VITE_CANOPY_DENOM_SYMBOL=CNPY

# Fee used only when the node does not report `sendFee` from /v1/query/fee-params.
VITE_CANOPY_FALLBACK_SEND_FEE=10000
